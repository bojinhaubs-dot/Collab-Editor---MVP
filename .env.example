# Copy these values into your shell environment before running server or demo.
# These fixed identities are for a local demonstration only.
LISTEN_ADDR=127.0.0.1:8080
BASE_URL=http://127.0.0.1:8080
MYSQL_DSN=collab:collab_demo_password@tcp(127.0.0.1:3309)/collab_mvp?charset=utf8mb4&parseTime=true&loc=Local
TOKEN_ADMIN=demo-admin-token
TOKEN_ALICE=demo-alice-token
TOKEN_BOB=demo-bob-token
TOKEN_VIEWER=demo-viewer-token
# Optional limits (defaults shown).
ROOM_QUEUE_CAPACITY=256
WS_SEND_QUEUE_CAPACITY=64
WS_MAX_MESSAGE_BYTES=65536
DOCUMENT_MAX_BYTES=1048576
